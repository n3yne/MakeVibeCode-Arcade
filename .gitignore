# Dependencies
node_modules/

# Electron build output
dist/
out/

# Build config folder is tracked; ignore only generated binaries inside it
build/icon.ico
build/icon.icns
build/icons/
build/icon-source.png

# Electron binary cache
electron/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.user

# Environment / secrets
.env
.env.local

# User data (API keys, conversations, settings saved at runtime)
userdata/

# Capacitor iOS platform (add on macOS via: npx cap add ios)
# ios/ contains Xcode project — track it once generated; copies live in native-plugins/ios/
ios/

# Android build artifacts (keep source, ignore build output)
android/.gradle/
android/app/build/
android/build/
